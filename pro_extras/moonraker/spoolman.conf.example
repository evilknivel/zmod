# Optional: Spoolman (Filament-/Spulenverwaltung) – Server läuft extern,
# z. B. als Home-Assistant-Add-on oder Docker auf dem NAS.
# Inhalt in mod_data/user.moonraker.conf einfügen, IP anpassen, dann REBOOT.
# Fluidd zeigt danach die Spulen-Auswahl im Dashboard an.

[spoolman]
server: http://192.168.1.10:7912
sync_rate: 5
